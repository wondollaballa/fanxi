# Fanxi server configuration. Copy to .env and source it, or set these in your service manager.
# Every value is optional; these are the defaults except where noted.

# Network
FANXI_BIND=127.0.0.1            # 0.0.0.0 to serve a LAN
FANXI_HTTP_PORT=8080
FANXI_PUBLIC_HOST=127.0.0.1     # the address the game client can reach (required for remote play)

# Storage
FANXI_DB=data/fanxi.db
FANXI_GAME_DIR=                 # folder with FFXiMain.dll and res/compress.dat
FANXI_HUFFMAN=                  # or point directly at the folder holding compress.dat

# Accounts and sessions
FANXI_REGISTRATION=1
FANXI_MAX_CHARACTERS=0         # 0 = unlimited characters per account
FANXI_MAX_SUBS=5               # server-owned sub-accounts one main may have; 0 disables them
FANXI_SESSION_DAYS=30
FANXI_LOGIN_TOKEN_SECONDS=120
FANXI_GAME_SESSION_HOURS=12

# Admin: set a long random value, or leave empty and use an account with role=admin
FANXI_ADMIN_KEY=

# TLS (generated on first run when missing)
FANXI_TLS_CERT=data/tls/auth-cert.pem
FANXI_TLS_KEY=data/tls/auth-key.pem

# Logging
FANXI_LOG_LEVEL=info
# FANXI_ZONE_DEBUG=1
