# Never commit anything derived from Square Enix binaries (README, "Rules").
generated/
build/
out/
*.dll
*.exe
*.dat
*.DAT
*.unpacked.*

# Fanxi's own runtime data: database, TLS keys, launcher settings and logs.  The source
# datasets the server reads are tracked, so a fresh clone has them for the tests and generators.
data/*
!data/skills.json
!data/weapon_skills.json
!data/skillchains.json
!data/limbus_r30.json
!data/odyssey_r30.json
tools/data/
*.db
*.db-wal
*.db-shm
.env
.venv/

# Tooling noise
__pycache__/
*.pyc
*.obj
*.pdb
*.ilk
*.lib
*.exp
.vs/

# Jython compiles the discovery scripts next to themselves
*$py.class
.DS_Store

# Character previews captured from the user's own game client, not distributable
# (tools/capture_character_previews.py writes them for the launcher's Design page)
launcher-rs/public/design/
