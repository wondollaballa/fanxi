# Never commit anything derived from Square Enix binaries (README, "Rules").
generated/
build/
out/
*.dll
*.exe
*.dat
*.DAT
*.unpacked.*

# Fanxi's own runtime data: database, TLS keys, launcher settings and logs.  The source
# datasets the server reads are tracked, so a fresh clone has them for the tests and generators.
data/*
# Walkable zone grids are derived from the player's own game files (never commit them)
data/nav/
!data/skills.json
!data/exp_table.json
!data/job_points.json
!data/spell_levels.json
!data/song_potency.json
!data/job_ability_status.json
!data/weapon_skills.json
!data/skillchains.json
!data/weapon_skill_properties.json
!data/limbus_r30.json
# The Telopanos weapons (the furnaces' Su5 gear) are their own dataset.  Like
# odyssey_extra_r30.json, forgetting this line does not fail the build: the code
# and the migration deploy, and the RP card silently lists no weapons.
!data/limbus_weapons_r30.json
!data/odyssey_r30.json
# Odyssey's extra pieces (Bunzi's, Ikenga's, Mpaca's, Gekkei, Kunimitsu and the
# ten Sheol Gaol accessories, the Beithir Ring among them) live in their own
# merged dataset.  Whitelisting it is not optional: a missing file silently
# removes those items from the augment registry.
!data/odyssey_extra_r30.json
!data/oboro_r25.json
!data/nolan_mezzotint.json
!data/oseem_glyptics.json
!data/skirmish.json
!data/sinister_reign.json
!data/temenos_r30.json
!data/moonshade.json
!data/magian.json
!data/jug_pets.json
tools/data/
*.db
*.db-wal
*.db-shm
.env
.venv/

# Tooling noise
__pycache__/
*.pyc
*.obj
*.pdb
*.ilk
*.lib
*.exp
.vs/

# Jython compiles the discovery scripts next to themselves
*$py.class
.DS_Store

# Character previews captured from the user's own game client, not distributable
# (tools/capture_character_previews.py writes them for the launcher's Design page)
launcher-rs/public/design/
