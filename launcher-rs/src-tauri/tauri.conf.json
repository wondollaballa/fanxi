{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fanxi Launcher",
  "version": "0.1.0",
  "identifier": "com.fanxi.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fanxi Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 1020,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../gearswap": "gearswap"
    },
    "category": "Game",
    "shortDescription": "Fanxi Launcher",
    "longDescription": "Sign in, create characters and launch FINAL FANTASY XI on your own Fanxi world.",
    "copyright": "Fanxi contributors",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
